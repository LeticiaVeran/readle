# Copy this file to a file named .env and fill in your own values.
# The .env file must NOT go to GitHub (it is listed in .gitignore).

# PostgreSQL database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=readle
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Generative AI (item 7f) - Groq, free and with no credit card
# Create the key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
